{
 "functions": {
  "api/photo.js": {
   "maxDuration": 20
  },
  "api/shared.js": {
   "maxDuration": 15
  }
 },
 "headers": [
  {
   "source": "/app/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/app/data/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    }
   ]
  }
 ]
}